generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String
  name       String
  cards      Card[]
  loans      Loan[]
  expenses   Expense[]
  recurringExpenses RecurringExpense[]
  categories Category[]
  bankConnections BankConnection[]
  bankTransactions BankTransaction[]
  createdAt  DateTime   @default(now())
}

model Card {
  id          String       @id @default(cuid())
  userId      String
  name        String
  brand       String
  limitCents  Int          @default(0)
  closingDay  Int
  dueDay      Int
  paymentDay  Int?
  color       String       @default("#8de0b8")
  icon        String       @default("card")
  status      String       @default("ACTIVE")
  description String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   CardPurchase[]
  invoices    CardInvoice[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([userId, status])
}

model Category {
  id        String        @id @default(cuid())
  userId    String
  name      String
  color     String        @default("#8de0b8")
  icon      String        @default("tag")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases CardPurchase[]
  expenses  Expense[]
  recurringExpenses RecurringExpense[]
  @@unique([userId, name])
}

model CardPurchase {
  id            String           @id @default(cuid())
  cardId        String
  categoryId    String?
  description   String
  purchaseDate  DateTime
  totalCents    Int
  installments  Int
  isRecurring   Boolean          @default(false)
  recurringActive Boolean         @default(true)
  note          String?
  card          Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rows          CardInstallment[]
  createdAt     DateTime          @default(now())
  @@index([cardId, purchaseDate])
}

model CardInvoice {
  id             String            @id @default(cuid())
  cardId         String
  referenceMonth String
  closingDate    DateTime
  dueDate        DateTime
  paymentDate    DateTime?
  totalCents     Int               @default(0)
  status         String            @default("OPEN")
  paidAt         DateTime?
  card           Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  installments   CardInstallment[]
  @@unique([cardId, referenceMonth])
}

model CardInstallment {
  id              String             @id @default(cuid())
  purchaseId      String
  invoiceId       String?
  referenceMonth  String
  number          Int
  amountCents     Int
  status          String             @default("PENDING")
  purchase        CardPurchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  invoice         CardInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@unique([purchaseId, number])
  @@index([referenceMonth, status])
}

model Loan {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  principalCents     Int
  totalInstallments  Int
  installmentCents   Int
  dueDay             Int
  paymentDay         Int?
  startDate          DateTime
  receivedDate       DateTime?
  paidInstallments   Int      @default(0)
  interestRate       Float?
  status             String   @default("ACTIVE")
  lastPaidAt         DateTime?
  notes              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}

model Expense {
  id          String        @id @default(cuid())
  userId      String
  categoryId  String?
  name        String
  amountCents Int
  dueDate     DateTime
  paymentDate DateTime?
  scheduleType String       @default("FIXED")
  scheduleAfterDay Int?
  status      String        @default("PENDING")
  paidAt      DateTime?
  type        String        @default("OTHER")
  notes       String?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  @@index([userId, dueDate, status])
}

model RecurringExpense {
  id            String                    @id @default(cuid())
  userId        String
  categoryId    String?
  name          String
  amountCents   Int
  firstDueDate  DateTime
  paymentDay    Int?
  status        String                    @default("ACTIVE")
  type          String                    @default("OTHER")
  notes         String?
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences   RecurringExpenseOccurrence[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  @@index([userId, status, firstDueDate])
}

model RecurringExpenseOccurrence {
  id           String          @id @default(cuid())
  recurringId  String
  referenceMonth String
  dueDate      DateTime
  paymentDate  DateTime?
  status       String          @default("PENDING")
  paidAt       DateTime?
  recurring    RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  @@unique([recurringId, referenceMonth])
  @@index([referenceMonth, status])
}

model BankConnection {
  id               String @id @default(cuid())
  userId           String
  itemId           String @unique
  connectorId      Int
  institution      String
  status           String @default("UPDATING")
  sandbox          Boolean @default(false)
  enabled          Boolean @default(true)
  lastSyncedAt     DateTime?
  providerUpdatedAt DateTime?
  consentExpiresAt DateTime?
  syncStartedAt    DateTime?
  refreshRequestedAt DateTime?
  syncError        String?
  createdAt        DateTime @default(now())
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts         BankAccount[]
  @@unique([userId, connectorId])
}

model BankAccount {
  id             String @id @default(cuid())
  connectionId   String
  externalId     String @unique
  name           String
  type           String
  subtype        String
  currency       String @default("BRL")
  numberLast4    String?
  balanceCents   Int?
  limitCents     Int?
  availableLimitCents Int?
  closingDate    DateTime?
  dueDate        DateTime?
  lastSyncedAt   DateTime?
  active         Boolean @default(true)
  connection     BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]
  bills          BankBill[]
  @@index([connectionId, active])
}

model BankTransaction {
  id             String @id @default(cuid())
  userId         String
  accountId      String
  externalId     String
  stableKey      String
  description    String
  date           DateTime
  amountCents    Int
  currency       String @default("BRL")
  direction      String
  status         String
  providerCategory String?
  suggestedCategory String?
  operationType  String?
  billExternalId String?
  installmentNumber Int?
  totalInstallments Int?
  referenceMonth String?
  reviewStatus   String @default("NEW")
  linkedKind     String?
  linkedId       String?
  reviewedAt     DateTime?
  lastSeenAt     DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, stableKey])
  @@index([userId, date, reviewStatus])
  @@index([accountId, externalId])
  @@unique([userId, linkedKind, linkedId])
}

model BankBill {
  id             String @id @default(cuid())
  accountId      String
  externalId     String
  dueDate        DateTime
  closingDate    DateTime?
  totalCents     Int
  currency       String
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, externalId])
}
